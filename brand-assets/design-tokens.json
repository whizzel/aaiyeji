{
  "$description": "AAIYEJI design tokens — source of truth alongside brand-tokens.css. Initial concept, pending formal brand approval. Keep both files in sync.",
  "status": "concept",
  "colors": {
    "wine": { "value": "#70233F", "purpose": "Primary brand colour, key buttons and strong accents" },
    "deep": { "value": "#351824", "purpose": "Deep text, dark sections and premium contrast" },
    "gold": { "value": "#C99B50", "purpose": "Antique-gold details, fine borders and highlights" },
    "ivory": { "value": "#FBF7F0", "purpose": "Main warm background" },
    "blush": { "value": "#F0DFDA", "purpose": "Soft section/card tint" },
    "sage": { "value": "#7D927F", "purpose": "Restrained secondary accent" },
    "ink": { "value": "#2D2529", "purpose": "Body text" },
    "white": { "value": "#FFFFFF", "purpose": "Clean card surfaces" },
    "wineSoft": { "value": "#8A3A58", "purpose": "Hover / lighter wine" },
    "goldSoft": { "value": "#E4C98F", "purpose": "Light gold for dark surfaces" },
    "ivoryDim": { "value": "#F4ECDF", "purpose": "Slightly deeper ivory for alternation" },
    "line": { "value": "#E7DCC9", "purpose": "Hairline borders on light surfaces" },
    "night": { "value": "#241019", "purpose": "Darkest wine-night, royal demo surface" }
  },
  "typography": {
    "display": {
      "family": "Cormorant Garamond",
      "fallbacks": ["Georgia", "Times New Roman", "serif"],
      "usage": "Editorial headlines, couple names, large numerals",
      "weights": [400, 500, 600, 700],
      "italic": true
    },
    "body": {
      "family": "DM Sans",
      "fallbacks": ["system-ui", "Segoe UI", "sans-serif"],
      "usage": "Body copy, UI controls, labels",
      "weights": [400, 500, 600, 700]
    },
    "indic": {
      "family": "Noto Serif Devanagari",
      "fallbacks": ["Noto Sans Devanagari", "Mangal", "serif"],
      "usage": "Hindi/Marathi and other Devanagari content; add regional Noto fonts when a new script is supported"
    }
  },
  "radii": { "card": "1rem", "button": "9999px", "phone": "2rem" },
  "spacing": { "section": "5rem", "sectionMobile": "3.5rem", "containerMax": "72rem" },
  "motifs": ["welcome arch / doorway", "fine floral line art", "jaali-inspired geometry", "thin gold rules", "soft paper texture"]
}
