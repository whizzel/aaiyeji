# Aaiyeji — environment configuration
# Copy this file to `.env.local` and fill in REAL, company-owned values before launch.
# Every variable is optional. Leave a value empty to disable the related feature honestly
# (the site will never invent contact details or pretend an enquiry was sent).

# Public canonical URL of the deployed site, no trailing slash.
# Used for metadata, Open Graph, canonical links and the sitemap.
# Example format: https://your-real-domain.com
NEXT_PUBLIC_SITE_URL=

# WhatsApp business number in international format: country code + digits only,
# no "+", spaces, dashes or brackets. Example format: 9198XXXXXXXX
# When set, "Chat on WhatsApp" buttons and the enquiry form open a prefilled WhatsApp chat.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Real company contact email. Used as the enquiry fallback when WhatsApp is not configured.
NEXT_PUBLIC_CONTACT_EMAIL=

# Full URL of the real company Instagram profile. Footer/social links appear only when set.
NEXT_PUBLIC_INSTAGRAM_URL=
